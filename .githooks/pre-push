#!/usr/bin/env bash
# =============================================================================
# pre-push hook
#
# fast build check before allowing push to remote: does the whole workspace
# (lib + bins + tests + examples) still COMPILE? this catches the common
# breakage class -- a signature change that misses a call site, a stale example
# -- in well under a minute, without codegen or running the test farm.
#
# it deliberately does NOT run the test suite. release builds + heavy
# integration/convergence tests take many minutes and belong in CI, not in the
# push path. run them yourself when relevant:
#   cargo test --release --manifest-path src/Cargo.toml --workspace
#
# to bypass (emergencies only):
#   git push --no-verify
# =============================================================================

set -u

workspace="src"

# ---------------------------------------------------------------------------
# authorship guard
#
# authorship denotes accountability for the code, which an automated tool
# cannot hold; tooling credit lives in README.md instead. a machine co-author
# trailer additionally registers the address in the forge's contributor graph.
#
# a merge that pulls a pre-rewrite lineage back alongside a rewritten one
# silently restores such a trailer, so the invariant is checked against every
# commit reachable from the tip being pushed rather than only new commits.
# ---------------------------------------------------------------------------
trailer_re='^[[:space:]]*co-authored-by:.*(claude|anthropic)'

while read -r _local_ref local_sha _remote_ref _remote_sha; do
    # all-zero local sha means the ref is being deleted; nothing to inspect
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    offender=$(git rev-list --max-count=1 -i -E --grep="$trailer_re" "$local_sha")
    if [ -n "$offender" ]; then
        echo "push rejected: machine co-author trailer reachable from $local_sha"
        echo ""
        git log -1 --format='  %h %s' "$offender"
        git log -1 --format='%B' "$offender" | grep -iE "$trailer_re" | sed 's/^/    /'
        echo ""
        echo "this usually means a merge restored pre-rewrite history."
        echo "reset onto the rewritten lineage instead of merging into it:"
        echo "  git fetch origin && git reset --hard origin/<branch>"
        exit 1
    fi
done

echo "running pre-push build check..."
echo "========================================"

if ! command -v cargo >/dev/null 2>&1; then
    echo "warning: cargo not found -- skipping build check"
    exit 0
fi

if [ ! -f "${workspace}/Cargo.toml" ]; then
    echo "warning: no rust workspace at ${workspace}/ -- skipping build check"
    exit 0
fi

# `check --all-targets` type-checks lib, bins, tests, and examples without
# codegen (no -C opt-level, no linking of test binaries) -- the fast path.
echo "executing cargo check (${workspace}/, all targets)..."
if cargo check --workspace --all-targets --manifest-path "${workspace}/Cargo.toml"; then
    echo "========================================"
    echo "workspace compiles -- proceeding with push..."
    exit 0
else
    echo "========================================"
    echo "build check failed"
    echo ""
    echo "fix the compile errors before pushing"
    echo "or use 'git push --no-verify' to bypass"
    exit 1
fi
