#!/usr/bin/env bash
# =============================================================================
# pre-commit hook
#
# enforces the repository's symlink policy on the complete staged tree.
# git stores a link's target path under mode 120000. local links belong in
# ignored working-copy paths; committed content must satisfy the policy even
# when a link arrived through a rename, type change, or an earlier commit.
# null-delimited index entries preserve spaces and newlines in path names.
#
# to bypass (emergencies only):
#   git commit --no-verify
# =============================================================================

set -euo pipefail

git ls-files --stage -z | (
    found=0
    while IFS= read -r -d '' entry; do
        case "$entry" in
            "120000 "*)
                if [ "$found" -eq 0 ]; then
                    echo "pre-commit: refusing to commit symlink(s):" >&2
                fi
                found=1
                path=${entry#*$'\t'}
                printf '  %q\n' "$path" >&2
                ;;
        esac
    done

    if [ "$found" -eq 1 ]; then
        cat >&2 <<'EOF'

symlinks stay local under this repository's policy. keep the link on disk,
ignore its path, and remove it from the index, or commit the real files.

  git rm --cached -- <path>      keep the local link and remove it from the index
EOF
        exit 1
    fi
)
