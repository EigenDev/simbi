---
Language: Cpp
BasedOnStyle: LLVM

# --- Indentation & Spacing ---
IndentWidth: 4
TabWidth: 4
UseTab: Never
# Slightly increased limit. 80 is too narrow for modern screens/variable names.
ColumnLimit: 100
# Ensures namespace contents are indented (visual hierarchy).
NamespaceIndentation: All
# Indent 'public/private' labels for better visibility.
IndentAccessModifiers: false
IndentCaseLabels: true
IndentCaseBlocks: false
ContinuationIndentWidth: 4

# --- Alignment (The "Beauty" Factor) ---
# Aligns macros and assignments.
# Warning: This creates prettier code but can mess up Git diffs slightly.
AlignConsecutiveMacros: Consecutive
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignTrailingComments: true
AlignOperands: Align
# Creates a nice block look for arguments that wrap.
AlignAfterOpenBracket: BlockIndent
PointerAlignment: Left

# --- Braces & Wrapping ---
# Enforces strict safety (always use braces).
InsertBraces: true
# Prevents cramped "if (x) { ... }" on one line.
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false

# Vertical lists for arguments are much easier to scan than packed lines.
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# --- Brace Wrapping Style ---
# This config uses a consistent "Stroustrup/Allman Hybrid"
# It puts braces on new lines for major structures (Class, Function)
# but keeps them attached for control flow (if/for) to save vertical space.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel:  false
  AfterClass:      true
  AfterControlStatement: false
  AfterEnum:       false
  AfterFunction:   true
  AfterNamespace:  false
  AfterStruct:     true
  AfterUnion:      false
  BeforeCatch:     true
  BeforeElse:      true  # Stroustrup style (} else {)
  IndentBraces:    false
  SplitEmptyFunction: true
  SplitEmptyRecord: true

# --- Modern C++ Features ---
# Groups includes: Main header -> C++ libs -> C libs -> Local libs
SortIncludes: true
IncludeBlocks: Regroup
# Ensures template <...> is on its own line usually
AlwaysBreakTemplateDeclarations: Yes
# Adds a newline before 'public/private' for readability
EmptyLineBeforeAccessModifier: Always
# Clean up CRLF to LF
UseCRLF: false

# --- Casting ---
SpaceAfterCStyleCast: true
SpacesInCStyleCastParentheses: false
