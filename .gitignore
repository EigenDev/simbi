# build products
target/
build*/
__pycache__/
*.pyc
*.egg-info/
version.py
# built python extensions + dev.py's cpu/gpu stash backups (cpu_ext.so, gpu_ext.so,
# *.cpubak); generated by `dev.py install`, each ~200 MB.
simbi/libs/
*.cpubak
*.so

# run outputs and working directories, kept on disk rather than in history.
# `workspace/` holds the personal trees -- notes, docs, plots, movies, literature,
# scripts -- so they need one rule between them rather than six.
data/
workspace/
simbi/tools/extras/*
# the science tree is linked into the working copy from outside this repository
/simbi_configs/science

# output formats
*.h5
*.pdf
*.png
*.svg
*.html
*.csv

# local research notes stay private; the readme's two logo assets are public
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/simbi-dither-dark.png
!/docs/assets/simbi-dither-light.png
*.xml
*.mp4
*.log
*.job

# vhs output: upload the gif to github rather than committing it
assets/*.gif
assets/*.mp4

# editor, tool and environment state. a leading dot is the convention for "tooling, not
# project content", so every dot-DIRECTORY is ignored wholesale. `.githooks/` is the one
# exception: those hooks are shared, so they are re-included. anything else that needs
# tracking later (a `.github/` workflow, say) needs its own negation or it stays invisible.
# dot-FILES are not matched by `.*/` and are named individually.
.*/
!.githooks/
.DS_Store
.envrc
.python-version
